---
import About from "./About.astro";
import Home from "./Home.astro";
import Project from "./vue/Project.vue";

const { class: className, ...rest } = Astro.props;
---

<main class={className} {...rest}>
  <Home
    id="home"
    class="flex size-full flex-col items-center justify-between gap-[150px] md:gap-[200px] lg:flex-row lg:h-dvh"
  />
  <About id="about" class="mt-40 lg:mt-0 lg:h-screen" />
  <Project client:load id="projects" class="relative mt-5 lg:mt-0 lg:h-screen" />
</main>
