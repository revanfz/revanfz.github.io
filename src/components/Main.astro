---
import About from "./About.astro";
import Home from "./Home.astro";
import Toolbox from "./Toolbox.astro";
import Project from "./vue/Project.vue";

const { class: className, ...rest } = Astro.props;
---

<main class={className} {...rest}>
  <Home
    id="home"
    class="flex flex-col relative items-center justify-between lg:flex-row h-screen max-h-[640px] lg:max-h-screen md:portrait:h-[640px]"
  />
  <About id="about" class="relative lg:w-screen lg:left-1/2 lg:-translate-x-1/2 lg:px-30 lg:py-20 lg:mt-0 potrait:h-full lg:h-full lg:bg-[url('/bg.jpg')] lg:bg-cover lg:bg-center" />
  <Project client:load id="projects" class="my-12" />
  <Toolbox id="toolbox" class="mt-5 h-full" />
</main>
