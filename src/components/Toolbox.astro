---
import { FontAwesomeIcon } from "@fortawesome/vue-fontawesome";
import {
  faVuejs,
  faNodeJs,
  faReact,
  faLaravel,
  faGolang,
  faPython,
} from "@fortawesome/free-brands-svg-icons";
const { class: className, ...rest } = Astro.props;
---

<section class={className} {...rest}>
  <h2
    class="text-3xl bg-linear-to-r from-(--green) to-(--dark-purple) bg-clip-text text-transparent"
  >
    My Toolbox
  </h2>
  <div class="tech flex flex-col gap-4 [&_h3]:mb-2 [&_li>p]:mt-2">
    <div class="favorite">
      <h3 class="subheading">Favorite Toolbox</h3>
      <ul
        class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 md:gap-4 gap-2 items-center *:flex *:justify-center *:flex-col **:text-center *:border-2 *:border-(--fg2) *:rounded-md *:py-4"
      >
        <li>
          <FontAwesomeIcon icon={faVuejs} class="text-4xl md:text-7xl" />
          <p>Vue.js</p>
        </li>
        <li>
          <FontAwesomeIcon icon={faGolang} class="text-4xl md:text-7xl" />
          <p>Golang</p>
        </li>
        <li>
          <!-- Typescript -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-[2em] md:h-[3em] fill-(--fg)"
            viewBox="0 0 24 24"
          >
            <path
              d="M1.125 0C.502 0 0 .502 0 1.125v21.75C0 23.498.502 24 1.125 24h21.75c.623 0 1.125-.502 1.125-1.125V1.125C24 .502 23.498 0 22.875 0zm17.363 9.75c.612 0 1.154.037 1.627.111a6.38 6.38 0 0 1 1.306.34v2.458a3.95 3.95 0 0 0-.643-.361 5.093 5.093 0 0 0-.717-.26 5.453 5.453 0 0 0-1.426-.2c-.3 0-.573.028-.819.086a2.1 2.1 0 0 0-.623.242c-.17.104-.3.229-.393.374a.888.888 0 0 0-.14.49c0 .196.053.373.156.529.104.156.252.304.443.444s.423.276.696.41c.273.135.582.274.926.416.47.197.892.407 1.266.628.374.222.695.473.963.753.268.279.472.598.614.957.142.359.214.776.214 1.253 0 .657-.125 1.21-.373 1.656a3.033 3.033 0 0 1-1.012 1.085 4.38 4.38 0 0 1-1.487.596c-.566.12-1.163.18-1.79.18a9.916 9.916 0 0 1-1.84-.164 5.544 5.544 0 0 1-1.512-.493v-2.63a5.033 5.033 0 0 0 3.237 1.2c.333 0 .624-.03.872-.09.249-.06.456-.144.623-.25.166-.108.29-.234.373-.38a1.023 1.023 0 0 0-.074-1.089 2.12 2.12 0 0 0-.537-.5 5.597 5.597 0 0 0-.807-.444 27.72 27.72 0 0 0-1.007-.436c-.918-.383-1.602-.852-2.053-1.405-.45-.553-.676-1.222-.676-2.005 0-.614.123-1.141.369-1.582.246-.441.58-.804 1.004-1.089a4.494 4.494 0 0 1 1.47-.629 7.536 7.536 0 0 1 1.77-.201zm-15.113.188h9.563v2.166H9.506v9.646H6.789v-9.646H3.375z"
            ></path>
          </svg>
          <p>TypeScript</p>
        </li>
        <li>
          <!-- Tailwind -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-[2em] md:h-[3em] fill-(--fg)"
            viewBox="0 0 24 24"
          >
            <path
              d="M12.001,4.8c-3.2,0-5.2,1.6-6,4.8c1.2-1.6,2.6-2.2,4.2-1.8c0.913,0.228,1.565,0.89,2.288,1.624 C13.666,10.618,15.027,12,18.001,12c3.2,0,5.2-1.6,6-4.8c-1.2,1.6-2.6,2.2-4.2,1.8c-0.913-0.228-1.565-0.89-2.288-1.624 C16.337,6.182,14.976,4.8,12.001,4.8z M6.001,12c-3.2,0-5.2,1.6-6,4.8c1.2-1.6,2.6-2.2,4.2-1.8c0.913,0.228,1.565,0.89,2.288,1.624 c1.177,1.194,2.538,2.576,5.512,2.576c3.2,0,5.2-1.6,6-4.8c-1.2,1.6-2.6,2.2-4.2,1.8c-0.913-0.228-1.565-0.89-2.288-1.624 C10.337,13.382,8.976,12,6.001,12z"
            ></path>
          </svg>
          <p>Tailwind</p>
        </li>
        <li>
          <!-- Prisma -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-[2em] md:h-[3em] fill-(--fg)"
            viewBox="0 0 24 24"
          >
            <path
              d="M21.8068 18.2848L13.5528.7565c-.207-.4382-.639-.7273-1.1286-.7541-.5023-.0293-.9523.213-1.2062.6253L2.266 15.1271c-.2773.4518-.2718 1.0091.0158 1.4555l4.3759 6.7786c.2608.4046.7127.6388 1.1823.6388.1332 0 .267-.0188.3987-.0577l12.7019-3.7568c.3891-.1151.7072-.3904.8737-.7553s.1633-.7828-.0075-1.1454zm-1.8481.7519L9.1814 22.2242c-.3292.0975-.6448-.1873-.5756-.5194l3.8501-18.4386c.072-.3448.5486-.3996.699-.0803l7.1288 15.138c.1344.2856-.019.6224-.325.7128z"
            ></path>
          </svg>
          <p>Prisma</p>
        </li>
      </ul>
    </div>
    <div class="frontend">
      <h3 class="subheading">Frontend</h3>
      <ul
        class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 md:gap-4 gap-2 items-center *:flex *:justify-center *:flex-col *:text-center *:border-2 *:border-(--fg2) *:rounded-md *:py-4"
      >
        <li>
          <FontAwesomeIcon icon={faVuejs} class="text-4xl md:text-7xl" />
          <p>Vue.js</p>
        </li>
        <li>
          <FontAwesomeIcon icon={faReact} class="text-4xl md:text-7xl" />
          <p>React</p>
        </li>
        <li>
          <!-- Tailwind -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-[2em] md:h-[3em] fill-(--fg)"
            viewBox="0 0 24 24"
          >
            <path
              d="M12.001,4.8c-3.2,0-5.2,1.6-6,4.8c1.2-1.6,2.6-2.2,4.2-1.8c0.913,0.228,1.565,0.89,2.288,1.624 C13.666,10.618,15.027,12,18.001,12c3.2,0,5.2-1.6,6-4.8c-1.2,1.6-2.6,2.2-4.2,1.8c-0.913-0.228-1.565-0.89-2.288-1.624 C16.337,6.182,14.976,4.8,12.001,4.8z M6.001,12c-3.2,0-5.2,1.6-6,4.8c1.2-1.6,2.6-2.2,4.2-1.8c0.913,0.228,1.565,0.89,2.288,1.624 c1.177,1.194,2.538,2.576,5.512,2.576c3.2,0,5.2-1.6,6-4.8c-1.2,1.6-2.6,2.2-4.2,1.8c-0.913-0.228-1.565-0.89-2.288-1.624 C10.337,13.382,8.976,12,6.001,12z"
            ></path>
          </svg>
          <p>Tailwind</p>
        </li>
      </ul>
    </div>
    <div class="backend">
      <h3 class="subheading">Backend</h3>
      <ul
        class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 md:gap-4 gap-2 items-center *:flex *:justify-center *:flex-col *:text-center *:border-2 *:border-(--fg2) *:rounded-md *:py-4"
      >
        <li>
          <FontAwesomeIcon icon={faNodeJs} class="text-4xl md:text-7xl" />
          <p>Node.js</p>
        </li>
        <li>
          <FontAwesomeIcon icon={faGolang} class="text-4xl md:text-7xl" />
          <p>Golang</p>
        </li>
        <li>
          <!-- Prisma -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="h-[2em] md:h-[3em] fill-(--fg)"
          >
            <path
              d="M21.8068 18.2848L13.5528.7565c-.207-.4382-.639-.7273-1.1286-.7541-.5023-.0293-.9523.213-1.2062.6253L2.266 15.1271c-.2773.4518-.2718 1.0091.0158 1.4555l4.3759 6.7786c.2608.4046.7127.6388 1.1823.6388.1332 0 .267-.0188.3987-.0577l12.7019-3.7568c.3891-.1151.7072-.3904.8737-.7553s.1633-.7828-.0075-1.1454zm-1.8481.7519L9.1814 22.2242c-.3292.0975-.6448-.1873-.5756-.5194l3.8501-18.4386c.072-.3448.5486-.3996.699-.0803l7.1288 15.138c.1344.2856-.019.6224-.325.7128z"
            ></path>
          </svg>
          <p>Prisma</p>
        </li>
        <li>
          <!-- Mongo DB -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            class="h-[2em] md:h-[3em] fill-(--fg)"
          >
            <path
              d="M17.193 9.555c-1.264-5.58-4.252-7.414-4.573-8.115-.28-.394-.53-.954-.735-1.44-.036.495-.055.685-.523 1.184-.723.566-4.438 3.682-4.74 10.02-.282 5.912 4.27 9.435 4.888 9.884l.07.05A73.49 73.49 0 0111.91 24h.481c.114-1.032.284-2.056.51-3.07.417-.296.604-.463.85-.693a11.342 11.342 0 003.639-8.464c.01-.814-.103-1.662-.197-2.218zm-5.336 8.195s0-8.291.275-8.29c.213 0 .49 10.695.49 10.695-.381-.045-.765-1.76-.765-2.405z"
            ></path>
          </svg>
          <p>Mongo DB</p>
        </li>
        <li>
          <FontAwesomeIcon icon={faLaravel} class="text-4xl md:text-7xl" />
          <p>Laravel</p>
        </li>
      </ul>
    </div>
    <div class="languages">
      <h3 class="subheading">Programming Languages</h3>
      <ul
        class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 md:gap-4 gap-2 items-center *:flex *:justify-center *:flex-col *:text-center *:border-2 *:border-(--fg2) *:rounded-md *:py-4"
      >
        <li>
          <FontAwesomeIcon icon={faPython} class="text-4xl md:text-7xl" />
          <p>Python</p>
        </li>
        <li>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-[2em] md:h-[3em] fill-(--fg)"
            viewBox="0 0 24 24"
          >
            <path
              d="M1.125 0C.502 0 0 .502 0 1.125v21.75C0 23.498.502 24 1.125 24h21.75c.623 0 1.125-.502 1.125-1.125V1.125C24 .502 23.498 0 22.875 0zm17.363 9.75c.612 0 1.154.037 1.627.111a6.38 6.38 0 0 1 1.306.34v2.458a3.95 3.95 0 0 0-.643-.361 5.093 5.093 0 0 0-.717-.26 5.453 5.453 0 0 0-1.426-.2c-.3 0-.573.028-.819.086a2.1 2.1 0 0 0-.623.242c-.17.104-.3.229-.393.374a.888.888 0 0 0-.14.49c0 .196.053.373.156.529.104.156.252.304.443.444s.423.276.696.41c.273.135.582.274.926.416.47.197.892.407 1.266.628.374.222.695.473.963.753.268.279.472.598.614.957.142.359.214.776.214 1.253 0 .657-.125 1.21-.373 1.656a3.033 3.033 0 0 1-1.012 1.085 4.38 4.38 0 0 1-1.487.596c-.566.12-1.163.18-1.79.18a9.916 9.916 0 0 1-1.84-.164 5.544 5.544 0 0 1-1.512-.493v-2.63a5.033 5.033 0 0 0 3.237 1.2c.333 0 .624-.03.872-.09.249-.06.456-.144.623-.25.166-.108.29-.234.373-.38a1.023 1.023 0 0 0-.074-1.089 2.12 2.12 0 0 0-.537-.5 5.597 5.597 0 0 0-.807-.444 27.72 27.72 0 0 0-1.007-.436c-.918-.383-1.602-.852-2.053-1.405-.45-.553-.676-1.222-.676-2.005 0-.614.123-1.141.369-1.582.246-.441.58-.804 1.004-1.089a4.494 4.494 0 0 1 1.47-.629 7.536 7.536 0 0 1 1.77-.201zm-15.113.188h9.563v2.166H9.506v9.646H6.789v-9.646H3.375z"
            ></path>
          </svg>
          <p>TypeScript</p>
        </li>
        <li>
          <svg
            role="img"
            viewBox="0 0 24 24"
            class="h-[2em] md:h-[3em] fill-(--fg)"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M22.394 6c-.167-.29-.398-.543-.652-.69L12.926.22c-.509-.294-1.34-.294-1.848 0L2.26 5.31c-.508.293-.923 1.013-.923 1.6v10.18c0 .294.104.62.271.91.167.29.398.543.652.69l8.816 5.09c.508.293 1.34.293 1.848 0l8.816-5.09c.254-.147.485-.4.652-.69.167-.29.27-.616.27-.91V6.91c.003-.294-.1-.62-.268-.91zM12 19.11c-3.92 0-7.109-3.19-7.109-7.11 0-3.92 3.19-7.11 7.11-7.11a7.133 7.133 0 016.156 3.553l-3.076 1.78a3.567 3.567 0 00-3.08-1.78A3.56 3.56 0 008.444 12 3.56 3.56 0 0012 15.555a3.57 3.57 0 003.08-1.778l3.078 1.78A7.135 7.135 0 0112 19.11zm7.11-6.715h-.79v.79h-.79v-.79h-.79v-.79h.79v-.79h.79v.79h.79zm2.962 0h-.79v.79h-.79v-.79h-.79v-.79h.79v-.79h.79v.79h.79z"
            ></path></svg
          >
          <p>C++</p>
        </li>
        <li>
          <svg
            role="img"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            class="h-[2em] md:h-[3em] fill-(--fg)"
            ><path d="M24 24H0V0h24L12 12Z"></path>
            </svg>
          <p>Kotlin</p>
        </li>
       <li>
        <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" 
        class="h-[2em] md:h-[3em] fill-(--fg)"><path d="M7.01 10.207h-.944l-.515 2.648h.838c.556 0 .97-.105 1.242-.314.272-.21.455-.559.55-1.049.092-.47.05-.802-.124-.995-.175-.193-.523-.29-1.047-.29zM12 5.688C5.373 5.688 0 8.514 0 12s5.373 6.313 12 6.313S24 15.486 24 12c0-3.486-5.373-6.312-12-6.312zm-3.26 7.451c-.261.25-.575.438-.917.551-.336.108-.765.164-1.285.164H5.357l-.327 1.681H3.652l1.23-6.326h2.65c.797 0 1.378.209 1.744.628.366.418.476 1.002.33 1.752a2.836 2.836 0 0 1-.305.847c-.143.255-.33.49-.561.703zm4.024.715l.543-2.799c.063-.318.039-.536-.068-.651-.107-.116-.336-.174-.687-.174H11.46l-.704 3.625H9.388l1.23-6.327h1.367l-.327 1.682h1.218c.767 0 1.295.134 1.586.401s.378.7.263 1.299l-.572 2.944h-1.389zm7.597-2.265a2.782 2.782 0 0 1-.305.847c-.143.255-.33.49-.561.703a2.44 2.44 0 0 1-.917.551c-.336.108-.765.164-1.286.164h-1.18l-.327 1.682h-1.378l1.23-6.326h2.649c.797 0 1.378.209 1.744.628.366.417.477 1.001.331 1.751zM17.766 10.207h-.943l-.516 2.648h.838c.557 0 .971-.105 1.242-.314.272-.21.455-.559.551-1.049.092-.47.049-.802-.125-.995s-.524-.29-1.047-.29z"/></svg>
