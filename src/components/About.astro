---
const { class: className, ...rest } = Astro.props;
const now = new Date();
const age = now.getFullYear() - 2002;
---

<section class={className} {...rest}>
  <h2
    class="text-3xl bg-linear-to-r from-(--green) to-(--dark-purple) bg-clip-text text-transparent mb-4"
  >
    About Me
  </h2>
  <div class="description flex flex-col-reverse text-[#fbf1c7] items-center justify-center gap-[50px] lg:flex-row">
    <div class="flex flex-col gap-[20px] lg:w-1/2">
      <p>
        Hi! My name is Revan Fauzi Algifari, {
          age - (now.getMonth() < 5 ? 0 : 1)
        } years old. I am an Informatics Engineering fresh gradute from
        Institut Teknologi Sumatera (ITERA).
      </p>
      <p>
        I have some experience in web development and embedded systems (IoT).
        With a combination of my technical skills in web development, embedded
        systems, along with strong interest in artificial intelligence (AI), I
        am commited to applying my knowledge and skills to solve real-world
        problems.
      </p>
      <p>
        I am confident in my ability to make meaningful contributions by
        designing and developing innovative digital solutions that enhance
        business growth and operational efficiency
      </p>
    </div>
    <div class="photo grid items-center justify-center rounded-xl border border-(--dark-green) bg-(--dark-green) shadow-[14px_14px_var(--aqua)] max-w-[60vw] lg:w-1/2">
        <img src="profile.png" alt="Profie picture of Revan Fauzi Algifari" class="max-w-[500px] w-full" />
    </div>
  </div>
</section>
