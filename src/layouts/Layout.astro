---
import Footer from "../components/Footer.astro";
import Header from "../components/vue/Header.vue";
import "../styles/global.css"
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Revan Fauzi Algifari | Web Developer</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>
  <body class="bg-(--bg) text-(--fg) box-border scroll-smooth">
    <Header
      class="sticky w-full z-50 bg-transparent md:backdrop-blur-sm items-center"
      client:load
    />
    <slot />
    <Footer class="relative bottom-0 w-full my-10" />
  </body>
</html>
